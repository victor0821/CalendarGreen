# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
# Una variable vacía se trata como ausente.

# --- Obligatorias en la feature 000 ---
APP_ENV=                      # dev | prod  (en tu máquina local: siempre dev)
SUPABASE_URL=                 # URL del proyecto Supabase (calendargreen-dev en local)
SUPABASE_SERVICE_ROLE_KEY=    # clave de rol de servicio; solo backend, jamás frontend/logs/repo

# --- Opcionales ---
CORS_ORIGINS=http://localhost:5173   # orígenes permitidos, separados por comas
DB_HEALTH_TIMEOUT_SECONDS=3          # tiempo máximo de la verificación de la base

# --- Aún no obligatorias (se exigirán en su feature) ---
JWT_SECRET=                   # 001: firma de sesiones (>= 32 caracteres aleatorios)
GEMINI_API_KEY=               # 003: agente
GEMINI_MODEL=                 # 003: modelo de Gemini (nunca fijo en el código)
